# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Providers - Cost-Optimized Routing

## Groq (Ultra-fast, ultra-cheap: $0.05-0.10/M tokens)
## Used for: Simple summaries, quick operations
GROQ_API_KEY=your_groq_api_key

## OpenRouter (Model diversity: $0.50-1.00/M tokens)
## Used for: Semantic search, medium complexity tasks
OPENROUTER_API_KEY=your_openrouter_api_key

## Anthropic Claude (Complex reasoning: $3-15/M tokens)
## Used for: Synthesis, contradictions, academic analysis
ANTHROPIC_API_KEY=your_anthropic_api_key

## Google Gemini (FREE embeddings: 15 RPM, 1500/day free tier)
## Used for: Vector embeddings (primary, free)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

## OpenAI (Embeddings fallback: $0.02/M tokens)
## Used for: Vector embeddings (fallback when Gemini rate limited)
OPENAI_API_KEY=your_openai_api_key

# Embedding Configuration (Optional)
# EMBEDDING_PROVIDER=dual                    # dual | gemini-only | openai-only (default: dual)
# EMBEDDING_DIMENSION=1536                   # 768 | 1536 | 3072 (default: 1536)
# EMBEDDING_FALLBACK_ENABLED=true            # Auto-fallback to OpenAI (default: true)
# EMBEDDING_COST_LOGGING=true                # Track API costs (default: true)
# GEMINI_RATE_LIMIT_RPM=15                   # Requests per minute (default: 15)
# GEMINI_RATE_LIMIT_DAILY=1500               # Requests per day (default: 1500)

# Error Tracking (Optional)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn  # For Sentry error tracking in production

# Admin Configuration
# ADMIN_EMAILS=admin@example.com,admin2@example.com  # Comma-separated list of admin emails

# Security Secrets
# CRON_SECRET=your_random_secret_for_cron_jobs  # For verifying scheduled jobs
# WEBHOOK_SECRET=your_random_secret_for_webhooks  # For verifying webhooks
